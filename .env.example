# Copy to .env for Docker Compose and replace all placeholders locally.
# This file is a template; do not put real credentials in source control.
MYSQL_ROOT_PASSWORD=REPLACE_WITH_A_LOCAL_ROOT_PASSWORD
DB_USERNAME=employee_management
DB_PASSWORD=REPLACE_WITH_A_LOCAL_DATABASE_PASSWORD
JWT_SECRET=REPLACE_WITH_BASE64_OF_AT_LEAST_32_RANDOM_BYTES
JWT_EXPIRATION_MS=3600000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
